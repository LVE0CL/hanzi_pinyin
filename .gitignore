# ---------------------------------------------------------------
# .venv / 缓存 / 本地配置
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 运行时生成的配置（每台机器不同，不要提交）
config.json

# 并行开发时 `--config-dir .dev/A` 用掉的隔离配置目录
.dev/

# 编辑器
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地调试脚本（只忽略根目录的 _xxx.py）
# 注意别写成 `_*.py`：那会连 hpp/__init__.py 一起忽略掉，包初始化文件就进不了仓库
/_*.py

# PyInstaller 生成的 spec
*.spec
